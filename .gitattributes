# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Python, Config & Code files
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary and media assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.wav binary
*.mp3 binary
*.m4a binary
*.pt binary
*.pth binary
*.bin binary
*.onnx binary
*.safetensors binary
