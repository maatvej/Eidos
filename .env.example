# ==============================================================================
# EIDOS VOICE INTELLIGENCE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Скопируйте данный файл в .env для настройки окружения:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ОБЩИЕ НАСТРОЙКИ СИСТЕМЫ (SYSTEM & APPLICATION CORE)
# ------------------------------------------------------------------------------
# Название проекта, отображаемое в OpenAPI документации и интерфейсе
PROJECT_NAME="Eidos Voice Intelligence"

# Префикс версионирования REST API эндпоинтов
API_V1_STR="/api/v1"

# Режим разработки:
# - True: локальный запуск, автоматические фоновые корутины без Celery/Arq/Redis, SQLite по умолчанию
# - False: продакшн-режим с обязательным подключением Redis/PostgreSQL
DEV_MODE=True

# Использование брокера очередей Redis:
# - True: задачи транскрибации отправляются в Redis/Arq
# - False: задачи выполняются локально через Async Background Tasks в процессе FastAPI
USE_REDIS=False

# Локальный каталог для сохранения загруженных и обработанных аудиофайлов
STORAGE_DIR="./local_storage"

# Каталог для локального хранения и кэширования весов ML-моделей
MODELS_DIR="./models"

# ------------------------------------------------------------------------------
# 2. БАЗА ДАННЫХ И БРОКЕРЫ (DATABASE & REDIS CONFIGURATION)
# ------------------------------------------------------------------------------
# Строка подключения к базе данных (SQLAlchemy Async URL):
# - SQLite (локальный режим без внешних зависимостей): sqlite+aiosqlite:///./dev_app.db
# - PostgreSQL (продакшн): postgresql+asyncpg://postgres:postgres@localhost:5432/eidos_db
DATABASE_URL="sqlite+aiosqlite:///./dev_app.db"

# Хост и порт Redis (используется только при USE_REDIS=True)
REDIS_HOST="localhost"
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. ПОЛИТИКА ЛОКАЛЬНОГО ИЗОЛИРОВАННОГО ВЫПОЛНЕНИЯ (AIR-GAPPED & PRIVACY)
# ------------------------------------------------------------------------------
# Запрет использования удаленных облачных сервисов инференса:
# Все вычисления (Whisper, диаризация, NLP/LLM) выполняются на хост-машине
LOCAL_MODELS_ONLY=True

# Разрешение первичной загрузки весов моделей из интернета при первом запуске:
# - True: при отсутствии весов в models/ они скачиваются с HuggingFace Hub один раз и кэшируются
# - False: полный air-gapped режим, используются только заранее размещенные локальные файлы
ALLOW_MODEL_DOWNLOADS=True

# Строгий запрет отправки пользовательских аудиоданных, голосов и текстов в публичные внешние API:
ALLOW_EXTERNAL_API_CALLS=False

# ------------------------------------------------------------------------------
# 4. РАСПОЗНАВАНИЕ РЕЧИ FASTER-WHISPER (SPEECH-TO-TEXT / ASR)
# ------------------------------------------------------------------------------
# Размер основной модели Faster-Whisper:
# Допустимые варианты: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL_SIZE="large-v3-turbo"

# Запасная легковесная модель при нехватке памяти/ресурсов
WHISPER_FALLBACK_MODEL_SIZE="medium"

# Корневой каталог для хранения весов Faster-Whisper (если None, используется стандартный кэш HuggingFace)
# WHISPER_DOWNLOAD_ROOT="./models/whisper"

# Использовать строго локальные файлы Whisper без проверки обновлений в сети
WHISPER_LOCAL_FILES_ONLY=False

# Вычислительное устройство для Whisper: cpu, cuda (NVIDIA GPU), auto
WHISPER_DEVICE="cpu"

# Тип квантования/точности вычислений:
# - int8: оптимально для CPU (быстро и экономично по RAM)
# - float16: оптимально для NVIDIA GPU с CUDA
# - auto: автоопределение (float16 для CUDA, int8 для CPU)
WHISPER_COMPUTE_TYPE="int8"

# Количество потоков CPU для инференса Whisper CTranslate2
WHISPER_CPU_THREADS=4

# Количество параллельных воркеров транскрибации
WHISPER_NUM_WORKERS=1

# Параметры декодирования лучевого поиска (Beam Search):
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_PATIENCE=1.0
WHISPER_REPETITION_PENALTY=1.05
WHISPER_NO_REPEAT_NGRAM_SIZE=3
WHISPER_CONDITION_ON_PREVIOUS_TEXT=False

# Начальный системный промпт для подсказки пунктуации и доменной терминологии
WHISPER_INITIAL_PROMPT="Стенограмма деловой встречи, совещания, презентации. Используйте корректную пунктуацию, заглавные буквы, разделение предложений и терминологию."

# Параметры детектора активности голоса Silero VAD в Whisper:
# Минимальная длительность тишины (мс) для разделения фраз
WHISPER_VAD_MIN_SILENCE_MS=400
# Дополнительный отступ тишины (мс) до и после найденного речевого сегмента
WHISPER_VAD_SPEECH_PAD_MS=300

# ------------------------------------------------------------------------------
# 5. ПРЕПРОЦЕССИНГ АУДИО (FFMPEG & AUDIO ENHANCEMENTS)
# ------------------------------------------------------------------------------
# Динамическая нормализация громкости (EBU R128 двухпроходный фильтр)
AUDIO_NORMALIZE_LOUDNESS=True

# Спектральное шумоподавление FFT (afftdn)
AUDIO_NOISE_REDUCTION=True

# Полосовой фильтр человеческого голоса (80 Гц - 7500 Гц)
AUDIO_BANDPASS_FILTER=True

# Количество потоков FFmpeg для обработки аудио
FFMPEG_THREADS=2

# Размер чанка при потоковой загрузке аудиофайла (в байтах: 1048576 = 1MB)
UPLOAD_CHUNK_SIZE=1048576

# ------------------------------------------------------------------------------
# 6. ДИАРИЗАЦИЯ СПИКЕРОВ И ГОЛОСОВЫЕ ПРОФИЛИ (SPEAKER DIARIZATION & VOICE MEMORY)
# ------------------------------------------------------------------------------
# Токен HuggingFace для доступа к нейросетевому пайплайну PyAnnote Diarization 3.1
# (Если токен не задан или равен hf_dummy_token, автоматически используется локальная спектральная кластеризация)
PYANNOTE_AUTH_TOKEN="hf_dummy_token"

# Опциональный путь к локально сохраненной модели PyAnnote (например, ./models/pyannote)
# PYANNOTE_LOCAL_MODEL_PATH="./models/pyannote"

# Ограничения числа спикеров (None = автоопределение)
# DIARIZATION_MIN_SPEAKERS=2
# DIARIZATION_MAX_SPEAKERS=5

# Порог косинусного сходства голосовых эмбеддингов для идентификации профилей пользователей (0.0 - 1.0)
VOICE_SIMILARITY_THRESHOLD=0.75

# Размерность акустических голосовых векторов (MFCC + Pitch F0 + Formants)
VOICE_EMBEDDING_DIM=32

# ------------------------------------------------------------------------------
# 7. LLM & СУММАРИЗАЦИЯ ВСТРЕЧ (MEETING INTELLIGENCE & SUMMARIZATION)
# ------------------------------------------------------------------------------
# Базовый URL для OpenAI-совместимого локального LLM-сервера (Ollama, vLLM, LocalAI):
# - Ollama: http://localhost:11434/v1
# - vLLM / LocalAI: http://localhost:8000/v1
LLM_BASE_URL="http://localhost:11434/v1"

# API ключ для доступа к локальному эндпоинту (или "none" для отключения попыток подключения к LLM API)
LLM_API_KEY="local-key"

# Имя модели в локальном сервере (например, llama3, qwen2.5, mistral)
LLM_MODEL_NAME="llama3"

# Температура генерации (0.0 - 1.0)
LLM_TEMPERATURE=0.2

# Максимальное количество токенов в ответе LLM
LLM_MAX_TOKENS=4096

# Лимит потоков PyTorch для фоновых вычислений
TORCH_NUM_THREADS=4

# ------------------------------------------------------------------------------
# 8. ДИАГНОСТИКА И ПРОФИЛИРОВАНИЕ (PERFORMANCE PROFILING & METRICS)
# ------------------------------------------------------------------------------
# Включение встроенного легковесного профилировщика cProfile:
# - True: детальные профили выполнения пишутся в PROFILING_OUTPUT_DIR
# - False: профилирование отключено (нулевой оверхед)
PROFILING_ENABLED=False

# Каталог для сохранения дампов профилирования .pstats и отчетов
PROFILING_OUTPUT_DIR="./profiles"

# Сортировка метрик в отчетах: cumulative, time, calls
PROFILING_SORT_BY="cumulative"

# Лимит строк функций в генерируемых отчетах CLI
PROFILING_RESTRICTION_LIMIT=30

# Порог фиксации медленных операций (мс): 0.0 = фиксировать все профилируемые функции
PROFILING_SLOW_THRESHOLD_MS=0.0
